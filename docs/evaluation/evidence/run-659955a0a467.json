    "source": "from demo_app.app.main import checkout\nfrom demo_app.app.models import CheckoutRequest\nfrom demo_app.app.store import reset_state\n\n\ndef setup_function() -> None:\n    reset_state()\n\n\ndef test_timeout_gateway_results_in_failed_order() -> None:\n    request = CheckoutRequest(\n        order_id=\"order-517\",\n        amount=20,\n        idempotency_key=\"key-517\",\n        provider_mode=\"timeout\",\n    )\n    order = checkout(request)\n    assert order.status == \"failed\"\n    assert order.charge_id is None\n",
