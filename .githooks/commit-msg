#!/bin/sh
# Reject commit messages that credit an AI coding agent (see AGENTS.md).
# Installed via `make hooks`; CI runs this same script on every PR commit.
# Usage: commit-msg <message-file>

AGENTS='claude|anthropic|cursor|copilot|codex|openai|chatgpt|gemini|devin|aider|windsurf|codeium'

if grep -inE "^[[:space:]]*co-authored-by:.*($AGENTS)" "$1" ||
   grep -inE "generated (with|by) .*($AGENTS)" "$1"; then
    echo >&2
    echo "commit-msg: AI agent attribution found in the commit message (line shown above)." >&2
    echo "Remove the Co-authored-by trailer or 'Generated with' footer; see AGENTS.md." >&2
    exit 1
fi
