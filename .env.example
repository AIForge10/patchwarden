# Copy to .env and fill in your own values. Never commit .env.

# Nebius Token Factory (copy base URL + exact NVIDIA model ID from the console; verify with `make probe`)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL_REASONING=
NEBIUS_MODEL_FAST=
# Optional patch-model ladder: attempt 1 uses the first model, and only a failed verification
# moves to the next, e.g. nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B,nvidia/nemotron-3-super-120b-a12b,nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_PATCH_MODELS=

TAVILY_API_KEY=
E2B_API_KEY=

# GitHub fine-grained token scoped ONLY to the demo target repo (contents + pull requests: read/write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_TARGET_REPO=

# Shared secret for signing alerts (generate: python -c "import secrets; print(secrets.token_hex(32))")
WEBHOOK_SECRET=
# Exact repo URL the agent is allowed to clone, e.g. https://github.com/<owner>/<repo>
ALLOWED_REPO_URL=

DATABASE_URL=sqlite:///./patchwarden.db
MAX_PATCH_ATTEMPTS=3
MAX_SCENARIOS=4
SANDBOX_TIMEOUT_SECONDS=180
# auto = E2B when E2B_API_KEY is set; local = disposable local directory (offline/dev)
SANDBOX_BACKEND=auto
# Also repair a confirmed second defect. Off: report it in the PR instead.
REPAIR_DISCOVERY=false
# Hosted "run live" button: live runs per UTC day (0 = off). Needs E2B and OPEN_PR_ON_VERIFIED=false.
PUBLIC_DEMO_RUNS_PER_DAY=0
# Let those public runs open real human-review PRs on GITHUB_TARGET_REPO (needs OPEN_PR_ON_VERIFIED=true)
PUBLIC_DEMO_OPEN_PRS=false
RUN_DISCOVERY=true
OPEN_PR_ON_VERIFIED=true
