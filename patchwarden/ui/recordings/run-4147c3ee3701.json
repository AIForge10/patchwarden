    "patch": "--- a/demo_app/app/main.py\n+++ b/demo_app/app/main.py\n@@ -1,4 +1,5 @@\n from fastapi import FastAPI, HTTPException\n+from pydantic import ValidationError\n \n from .models import CheckoutRequest, Order, PaymentResult\n from .payments import charge\n@@ -11,7 +12,11 @@\n def checkout(request: CheckoutRequest) -> Order:\n     reserve_item(request.sku)\n     response = charge(request.amount, request.idempotency_key, request.provider_mode)\n-    result = PaymentResult.model_validate(response)\n+    try:\n+        result = PaymentResult.model_validate(response)\n+    except ValidationError:\n+        # Malformed response from payment gateway -> treat as failed\n+        return create_order(request.order_id, \"failed\")\n     if result.status == \"declined\":\n         return create_order(request.order_id, \"failed\")\n     return create_order(request.order_id, \"completed\", result.charge_id)\n--- a/demo_app/app/payments.py\n+++ b/demo_app/app/payments.py\n@@ -14,7 +14,10 @@\n         return {\"unexpected\": \"gateway payload\"}\n     if mode != \"normal\":\n         raise ValueError(\"unsupported provider mode\")\n-    _charges[idempotency_key] = _charges.get(idempotency_key, 0) + 1\n+    # Idempotent handling: if we have already processed this key, do not increment again.\n+    if idempotency_key in _charges:\n+        return PaymentResult(status=\"approved\", charge_id=f\"ch_{idempotency_key}\")\n+    _charges[idempotency_key] = 1\n     return PaymentResult(status=\"approved\", charge_id=f\"ch_{idempotency_key}\")\n \n \n",
