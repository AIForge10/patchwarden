      "source": "from demo_app.app.main import checkout\nfrom demo_app.app.models import CheckoutRequest\nfrom demo_app.app.store import reset_state\n\n\ndef setup_function() -> None:\n    reset_state()\n\n\ndef test_unknown_sku_results_in_failed_order() -> None:\n    # Simulate the production request that caused the KeyError\n    request = CheckoutRequest(\n        order_id=\"order-402\",\n        amount=30,\n        idempotency_key=\"order-402-key\",\n        provider_mode=\"normal\",\n        sku=\"sku-retired\",  # SKU not present in _INITIAL_STOCK\n    )\n    # Before a fix this will raise KeyError in store.reserve_item.\n    # After a fix the function should return an Order with a failed status.\n    order = checkout(request)\n    assert order.status == \"failed\"\n    assert order.order_id == \"order-402\"\n",
